{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LogSight",
  "version": "0.2.0",
  "identifier": "com.fu.logsight",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LogSight - 服务器日志查看器",
        "width": 1600,
        "height": 980,
        "minWidth": 1000,
        "minHeight": 620,
        "resizable": true,
        "maximizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "tabbingIdentifier": "logsight-tabs"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "跨平台远程服务器日志查看工具",
    "longDescription": "LogSight 是一款跨平台桌面应用，用于通过 SSH 连接远程服务器，实时流式查看日志文件、搜索关键字、过滤日志级别，支持多服务器多标签页管理。",
    "copyright": "Copyright © 2026 LogSight contributors",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "12.0",
      "exceptionDomain": "",
      "signingIdentity": null,
      "entitlements": null
    }
  },
  "plugins": {}
}
