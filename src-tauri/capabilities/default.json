{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "LogSight 默认权限配置",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "shell:allow-open",
    "shell:allow-execute",
    "clipboard-manager:allow-write-text",
    {
      "identifier": "core:window:allow-start-dragging",
      "allow": []
    },
    {
      "identifier": "core:window:allow-minimize",
      "allow": []
    },
    {
      "identifier": "core:window:allow-toggle-maximize",
      "allow": []
    },
    {
      "identifier": "core:window:allow-close",
      "allow": []
    },
    {
      "identifier": "core:event:allow-emit",
      "allow": ["*"]
    },
    {
      "identifier": "core:event:allow-listen",
      "allow": ["*"]
    }
  ]
}
